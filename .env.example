# Local development. Copy to .env.local if overrides are needed.
PORT=8000
HOST=127.0.0.1
SHOP_DATA_DIR=./var
# Set the externally visible HTTPS origin when deploying behind a reverse proxy.
# SHOP_ORIGIN=https://shop.example.by
# NODE_ENV=production
# Admin credentials are entered interactively via npm run admin:create.

# Pending orders expire automatically if the seller does not confirm them.
SHOP_RESERVE_HOURS=24
